@model WebShop.Models.OrderViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var items = ViewBag.Items as List<WebShop.Models.OrderItem> ?? new List<WebShop.Models.OrderItem>();
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between mb-4">
        <h3>Chi tiết đơn: <span class="text-primary">#@Model.Id</span></h3>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow mb-3">
                <div class="card-header bg-primary text-white">Khách hàng</div>
                <div class="card-body">
                    <p><strong>Tên:</strong> @Model.CustomerName</p>
                    <p><strong>SĐT:</strong> @Model.Phone</p>
                    <p><strong>Địa chỉ:</strong> @Model.Address</p>
                    <p><strong>Ngày đặt:</strong> @Model.OrderDate</p>
                </div>
            </div>

            <div class="card shadow">
                <div class="card-header fw-bold">Trạng thái: @Model.Status</div>
                <div class="card-body">
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="d-grid gap-2">
                            @if (Model.Status == "Pending")
                            {
                                <button type="submit" name="status" value="Shipping" class="btn btn-primary">Giao hàng</button>
                                <button type="submit" name="status" value="Cancelled" class="btn btn-danger">Hủy đơn</button>
                            }
                            else if (Model.Status == "Shipping")
                            {
                                <button type="submit" name="status" value="Completed" class="btn btn-success">Đã giao xong</button>
                            }
                            else
                            {
                                <span class="text-muted text-center">Đơn hàng đã kết thúc</span>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header">Sản phẩm</div>
                <table class="table mb-0">
                    <thead>
                        <tr><th>Hình</th><th>Tên</th><th>Giá</th><th>SL</th><th>Thành tiền</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td><img src="@item.ProductImage" width="50" onerror="this.src='/images/default.png'" /></td>
                                <td>@item.ProductName</td>
                                <td>@item.UnitPrice.ToString("N0")</td>
                                <td>@item.Quantity</td>
                                <td>@item.TotalPrice.ToString("N0")</td>
                            </tr>
                        }
                        <tr class="fw-bold bg-light">
                            <td colspan="4" class="text-end">TỔNG CỘNG:</td>
                            <td class="text-danger">@Model.TotalAmount.ToString("N0") đ</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>