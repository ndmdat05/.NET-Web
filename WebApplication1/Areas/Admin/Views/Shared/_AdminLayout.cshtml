    @{
    Layout = null;
}
<! DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    @* <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet"> *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <img src="~/images/logo.jpg" alt="Logo" class="logo" />
            <h2>Paddy Admin</h2>
        </div>

        <nav class="sidebar-nav">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link">
                <i class="fas fa-tachometer-alt"></i>
                <span>Dashboard</span>
            </a>
            <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="nav-link">
                <i class="fas fa-box"></i>
                <span>Sản Phẩm</span>
            </a>
            <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="nav-link">
                <i class="fas fa-tags"></i>
                <span>Danh Mục</span>
            </a>
            <a href="#orders" class="tab-link">
                <i class="fas fa-shopping-cart"></i>
                <span>Đơn Hàng</span>
            </a>
            <a href="#customers" class="tab-link">
                <i class="fas fa-users"></i>
                <span>Khách Hàng</span>
            </a>
            <a href="#blogs" class="tab-link">
                <i class="fas fa-newspaper"></i>
                <span>Bài Viết</span>
            </a>
            <a href="#reports" class="tab-link">
                <i class="fas fa-chart-bar"></i>
                <span>Báo Cáo</span>
            </a>
            <a href="#settings" class="tab-link">
                <i class="fas fa-cog"></i>
                <span>Cài Đặt</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <a asp-controller="Home" asp-action="Index" asp-area="">
                <i class="fas fa-store"></i>
                <span>Về Trang Chủ</span>
            </a>
            <a href="#" class="logout">
                <i class="fas fa-sign-out-alt"></i>
                <span>Đăng Xuất</span>
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Topbar -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Tìm kiếm..." />
                </div>
            </div>

            <div class="topbar-right">
                <div class="notification">
                    <i class="fas fa-bell"></i>
                    <span class="badge">3</span>
                </div>
                <div class="user-profile">
                    <img src="~/images/logo.jpg" alt="Admin" />
                    <div class="user-info">
                        <span class="user-name">Admin</span>
                        <span class="user-role">Quản trị viên</span>
                    </div>
                    <i class="fas fa-chevron-down"></i>
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <div class="page-content">
            @RenderBody()
        </div>
    </main>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="~/js/admin.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>