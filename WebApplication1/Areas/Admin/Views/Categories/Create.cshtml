@model WebShop.Models.Category
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm Danh Mục";
}

<div class="card shadow mb-4" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Thêm Danh Mục Mới</h6>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">

            <div class="form-group mb-3">
                <label class="form-label fw-bold">Tên danh mục (*)</label>
                <input asp-for="CategoryName" class="form-control" required placeholder="Ví dụ: Thức ăn cho mèo" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="form-label fw-bold">Mô tả</label>
                <textarea asp-for="Description" class="form-control" rows="5" placeholder="Nhập mô tả cho loại hàng này..."></textarea>
            </div>

            <hr />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> Lưu Danh Mục
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}