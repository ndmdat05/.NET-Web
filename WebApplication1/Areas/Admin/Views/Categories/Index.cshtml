@model List<WebShop.Models.Category>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Quản lý Danh mục</h2>
<a asp-action="Create" class="btn btn-primary mb-3">
    <i class="fas fa-plus"></i> Thêm Danh mục
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên Danh mục</th>
            <th>Mô tả</th>
            <th width="150">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CategoryName</td>
                <td>@item.Description</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a href="javascript:void(0)" onclick="deleteCategory('@item.Id')" class="btn btn-sm btn-danger">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function deleteCategory(id) {
            Swal.fire({
                title: 'Bạn chắc chắn xóa?',
                text: "Hành động này không thể hoàn tác!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Vâng, xóa nó!',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Hiện loading trong lúc chờ xóa
                    Swal.showLoading();

                    $.ajax({
                        url: '/Admin/Categories/Delete',
                        type: 'POST',
                        data: { id: id },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('Thành công!', res.message, 'success')
                                    .then(() => { location.reload(); });
                            } else {
                                // Hiện lỗi nếu server trả về false (VD: Còn sản phẩm trong danh mục)
                                Swal.fire('Không thể xóa!', res.message, 'error');
                            }
                        },
                        error: function (xhr, status, error) {
                            // Bắt lỗi hệ thống (404, 500)
                            console.error(error);
                            Swal.fire('Lỗi hệ thống!', 'Không thể kết nối đến Server. Mã lỗi: ' + xhr.status, 'error');
                        }
                    });
                }
            })
        }
    </script>
}