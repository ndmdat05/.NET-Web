@model List<WebShop.Models.Product>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Danh sách Hàng hóa</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    <i class="fas fa-plus"></i> Thêm Sản phẩm mới
</a>

<table class="table table-striped table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>Hình ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Giá bán</th>
            <th>Tồn kho</th>
            <th>Danh mục</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@item.MainImage" width="60" height="60" style="object-fit:cover; border: 1px solid #ddd; border-radius: 4px;"
                             onerror="this.src='/images/default.png'" />
                    </td>
                    <td>@item.Name</td>
                    <td style="color: red; font-weight: bold;">@item.Price.ToString("N0") đ</td>
                    <td>
                        @if (item.Quantity < 10)
                        {
                            <span class="badge bg-danger">Sắp hết: @item.Quantity</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@item.Quantity</span>
                        }
                    </td>
                    <td>@item.CategoryName</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Sửa">
                            <i class="fas fa-edit"></i>
                        </a>

                        <a href="javascript:void(0)" onclick="deleteProduct('@item.Id')" class="btn btn-sm btn-danger" title="Xóa">
                            <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">Chưa có sản phẩm nào. Hãy bấm nút Thêm mới!</td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function deleteProduct(id) {
            Swal.fire({
                title: 'Bạn có chắc chắn?',
                text: "Sản phẩm sẽ bị xóa vĩnh viễn cùng với hình ảnh!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Vâng, xóa nó!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Admin/Products/Delete',
                        type: 'POST',
                        data: { id: id },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('Đã xóa!', res.message, 'success')
                                .then(() => { location.reload(); });
                            } else {
                                Swal.fire('Lỗi!', res.message, 'error');
                            }
                        }
                    });
                }
            })
        }
    </script>
}