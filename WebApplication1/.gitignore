## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono Auto Generated Files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/

# Visual Studio 2017/2019 cache/options directory
.vs/
.vscode/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h

# NuGet Packages
*.nupkg
*.snupkg
packages/
*.pdb
*.cache
*.tmp
*.zip
*.bak

# .NET Core
.project
.project.json
*.deps.json
*.runtimeconfig.json
*.dll
*.exe

# Publish folder
publish/
# App_Data (optional)
App_Data/

# Logs
*.log

# Others
*.db
*.sqlite
*.sqlite3
*.mdf
*.ldf

# Rider
.idea/