@{
    ViewData["Title"] = "Chó Nhỏ Nên Ăn Gì?";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Blog-detail.css">
}

<div class="blog-detail-page-container">

    <div class="breadcrumb-section">
        <a asp-controller="Home" asp-action="Index">Trang Chủ</a>
        <span class="separator">/</span>
        <a asp-controller="Blog" asp-action="Index">Kiến Thức</a>
        <span class="separator">/</span>
        <span class="current">Chó Nhỏ Nên Ăn Gì?</span>
    </div>

    <div class="detail-container">

        <aside class="detail-sidebar">
            <h3>SỰ KIỆN MỚI</h3>
            <div class="line"></div>

            <div class="sb-item">
                <a asp-controller="Blog" asp-action="Detail" asp-route-id="cho-nho-an-gi">Chó nhỏ nên ăn gì?</a>
                <span>14 November 2025</span>
            </div>

            <h4 class="premium-title">PREMIUM PET FOOD</h4>
            <div class="line"></div>
        </aside>

        <div class="detail-main">

            <h1 class="blog-main-title">Chó Nhỏ Nên Ăn Gì? Tiêu Chí Chọn Thức Ăn Đầy Đủ Dinh Dưỡng và Phù Hợp</h1>

            <div class="post-meta">
                Nov 14, 2025
            </div>

            <div class="post-banner">
                <img src="~/images/blog1.webp" alt="Chó nhỏ ăn gì" class="img-responsive">
            </div>

            <h2 class="toc-title">Chuyên mục:</h2>
            <ul class="toc-list">
                <li>1. Chó nhỏ cần những dưỡng chất gì để phát triển khỏe mạnh?</li>
                <li>2. Tiêu chí cần lưu ý khi chọn thức ăn cho chó nhỏ</li>
                <li>3. Gợi ý một số dòng thức ăn phù hợp cho chó nhỏ</li>
                <li>4. Những sai lầm thường gặp khi chọn thức ăn cho chó nhỏ</li>
            </ul>

            <div class="post-content">
                <p>Nuôi chó nhỏ là niềm vui lớn với nhiều người yêu thú cưng. Tuy nhiên, việc chọn thức ăn cho chó nhỏ luôn khiến các chủ nuôi băn khoăn...</p>

                <h2>Chó nhỏ cần những dưỡng chất gì để phát triển khỏe mạnh?</h2>
                <p>Trong giai đoạn từ 1 tháng đến 6 tháng tuổi, đang ở thời kỳ phát triển nhanh chóng về cả thể chất lẫn trí não. Vì vậy, chế độ dinh dưỡng dành cho chúng cần phải thật sự đặc biệt và đầy đủ...</p>

                <h2>Protein giúp phát triển cơ bắp và tăng trưởng toàn diện</h2>
                <p>Protein là dưỡng chất thiết yếu cho quá trình xây dựng cơ bắp...</p>

                <h2>Chất béo cung cấp năng lượng và hỗ trợ hấp thụ vitamin</h2>
                <p>Chất béo là nguồn năng lượng chính giúp chó nhỏ hoạt động cả ngày...</p>

            </div>

        </div>
    </div>
</div>

@section Scripts {
}