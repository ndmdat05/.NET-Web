@model WebShop.Models.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

@section Styles {
}

<div id="slider-container">
    <div id="slider-cont">
        <div class="slider">
            <div class="slider-item">
                <img src="~/assets/img/banner_web_1880_x_720_px_d0cd69bd-82c2-4d89-ba1f-8fd08f172cc9.webp" alt="Banner Chính">
                <img src="~/assets/img/pet_1.webp" alt="Pet 1">
                <img src="~/assets/img/pet_2.webp" alt="Pet 2">
                <img src="~/assets/img/pet_3.webp" alt="Pet 3">
            </div>
            <div class="btns">
                <button class="btn-left btn"><i class="fa-solid fa-chevron-left"></i></button>
                <button class="btn-right btn"><i class="fa-solid fa-chevron-right"></i></button>
            </div>
            <div class="dots">
                <i class="fa-solid fa-circle"></i>
                <i class="fa-regular fa-circle"></i>
                <i class="fa-regular fa-circle"></i>
                <i class="fa-regular fa-circle"></i>
            </div>
        </div>
    </div>
</div>

<div id="policy-section">
    <div class="policy-container">
        <div class="policy-item">
            <i class="fa-solid fa-bag-shopping"></i>
            <p>Miễn phí <br> Vận chuyển</p>
        </div>
        <div class="divider"></div>
        <div class="policy-item">
            <i class="fa-solid fa-certificate"></i>
            <p>Sản phẩm <br>Chính hãng</p>
        </div>
        <div class="divider"></div>
        <div class="policy-item">
            <i class="fa-solid fa-wallet"></i>
            <p>Thanh toán <br> Tiện lợi</p>
        </div>
        <div class="divider"></div>
        <div class="policy-item">
            <i class="fa-solid fa-phone-volume"></i>
            <p>Hỗ trợ <br> Chuyên nghiệp</p>
        </div>
    </div>
</div>

<div id="banner-content">
    <div class="header-title">
        <h2>Mua sắm theo giống thú cưng</h2>
    </div>
    <div class="content-item">
        <a href="#"><img src="~/assets/img/dog_banner.webp" alt="Cún cưng" class="dog-item"></a>
        <a href="#"><img src="~/assets/img/cat_banner.webp" alt="Mèo cưng" class="cat-item"></a>
    </div>
</div>

<div id="collections-content">
    <div class="collections-header">
        <h2>Bộ Sưu Tập Cho Mèo Con</h2>
        <a asp-controller="Collections" asp-action="PateMeoCon" class="see-all">Xem tất cả</a>
    </div>
    <div class="collections-item">
        <div class="item">
            <a asp-controller="Collections" asp-action="Index" asp-route-categoryId="CAT002" asp-route-keyword="Pate">
                <img src="~/images/collections_1x.webp" alt="Pate Mèo Con">
                <p>Pate Mèo Con</p>
            </a>
        </div>

        <div class="item">
            <a asp-controller="Collections" asp-action="Index" asp-route-categoryId="CAT002" asp-route-keyword="Hạt">
                <img src="~/images/collections2.webp" alt="Thức Ăn">
                <p>Thức Ăn Cho Mèo Con</p>
            </a>
        </div>

        <div class="item">
            <a asp-controller="Collections" asp-action="Index" asp-route-categoryId="CAT002" asp-route-keyword="Cát">
                <img src="~/images/collections3.webp" alt="Cát Vệ Sinh">
                <p>Cát Vệ Sinh Mèo</p>
            </a>
        </div>

        <div class="item">
            <a asp-controller="Collections" asp-action="Index" asp-route-categoryId="CAT002" asp-route-keyword="Sữa Tắm">
                <img src="~/images/collections4.webp" alt="Sữa Tắm">
                <p>Sữa Tắm Cho Mèo Con</p>
            </a>
        </div>

        <div class="item">
            <a asp-controller="Collections" asp-action="Index" asp-route-categoryId="CAT002" asp-route-keyword="Đồ Chơi">
                <img src="~/images/collections5.webp" alt="Đồ Chơi">
                <p>Đồ Chơi Cho Mèo Con</p>
            </a>
        </div>

        <div class="item">
            <a asp-controller="Collections" asp-action="Index" asp-route-categoryId="CAT002" asp-route-keyword="Nhà">
                <img src="~/images/collections6.webp" alt="Nhà Mèo">
                <p>Nhà Cho Mèo</p>
            </a>
        </div>
    </div>
</div>

<div class="discount-product">
    <div class="dp_container">
        <div class="dp_header">
            <h2>Sản phẩm giảm giá</h2>
            <a asp-controller="Product" asp-action="Index" class="dp_see_all">Xem tất cả</a>
        </div>

        <div class="dp-slider">
            <div class="dp-wrapper">
                @if (Model.DiscountedProducts != null && Model.DiscountedProducts.Count > 0)
                {
                    foreach (var item in Model.DiscountedProducts)
                    {
                        <a href="/Product/Detail?id=@item.Id" class="di-link">
                            <div class="dp-item">
                                <img src="@item.ImageUrl" alt="@item.Name" onerror="this.src='/images/default.png'">
                                <h4>@item.Name</h4>
                                <p style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@item.Name</p>

                                @if (item.SalePrice > 0)
                                {
                                    <span class="price1" style="text-decoration: line-through;">@item.Price.ToString("N0")đ</span>
                                    <span class="price2">@item.SalePrice?.ToString("N0")đ</span>
                                }
                                else
                                {
                                    <span class="price2">@item.Price.ToString("N0")đ</span>
                                }
                                <i class="fa-regular fa-heart dp-icon"></i>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <p style="padding: 20px;">Chưa có sản phẩm khuyến mãi nào.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="recommend-items">
    <div class="deal_container">
        <div class="deal_header">
            <h2>Sản phẩm đề xuất</h2>
            <a href="#" class="deal_see_all">Xem tất cả</a>
        </div>
        <div class="deal-slider">
            <div class="deal-wrapper">
                @if (Model.RecommendedProducts != null && Model.RecommendedProducts.Count > 0)
                {
                    foreach (var item in Model.RecommendedProducts)
                    {
                        <a href="/Product/Detail?id=@item.Id" class="di-link">
                            <div class="deal-item">
                                <img src="@item.ImageUrl" alt="@item.Name" onerror="this.src='/images/default.png'">
                                <h4>@item.Name</h4>
                                <p style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@item.Name</p>

                                <span class="price">
                                    @(item.SalePrice > 0 ? item.SalePrice?.ToString("N0") : item.Price.ToString("N0"))đ
                                </span>
                                <i class="fa-regular fa-heart deal-icon"></i>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>

<div class="trademark_list">
    <div class="trademark_container">
        <div class="trademark_header">
            <h2>Top Thương Hiệu Boss Thích</h2>
            <p>Xem tất cả</p>
        </div>
        <div class="trademark_item">
            <div class="trade_logo">
                <div class="trade_img">
                    <img src="~/assets/img/trademark1.png" alt="">
                </div>
                <p>Nutrience</p>
            </div>
            <div class="trade_logo">
                <div class="trade_img">
                    <img src="~/assets/img/trademark2.png" alt="">
                </div>
                <p>Royal Canin</p>
            </div>
        </div>
    </div>
</div>

<div class="list-store">
    <div class="store-container">
        <div class="header-line">
            <hr>
            <h2 class="title-store">Mua Trực Tiếp Tại Cửa Hàng</h2>
        </div>
        <div class="store-item">
            <div class="store-img">
                <img src="~/assets/img/cuahang1.webp" alt="Paddy Pet Shop - Trường Sa">
            </div>
            <h3>Paddy Pet Shop - Trường Sa</h3>
            <p>168 Trường Sa, P. Gia Định, Tp. HCM (Phường 1, Q. Bình Thạnh cũ)</p>
            <button>Chỉ đường</button>
        </div>
        <div class="store-item">
            <div class="store-img">
                <img src="~/assets/img/cuahang2.webp" alt="Paddy Pet Shop - Nơ Trang Long">
            </div>
            <h3>Paddy Pet Shop - Nơ Trang Long</h3>
            <p>412/3 Nơ Trang Long, P. Bình Lợi Trung, Tp. HCM (Phường 13, Q.Bình Thạnh cũ)</p>
            <button>Chỉ đường</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/main.js"></script>
}