@{
    ViewData["Title"] = "Trang chủ";
}

<!-- SLIDER -->
<div id="slider-container">
    <div id="slider-cont">
        <div class="slider">
            <div class="slider-item">
                <img src="~/images/banner-home.webp" alt="">
                <img src="~/images/pet_1.webp" alt="">
                <img src="~/images/pet_2.webp" alt="">
                <img src="~/images/pet_3.webp" alt="">
            </div>
            <div class="dots">
                <i class="fa-solid fa-circle"></i>
                <i class="fa-regular fa-circle"></i>
                <i class="fa-regular fa-circle"></i>
                <i class="fa-regular fa-circle"></i>
            </div>
        </div>
    </div>
</div>
//abcdd
<!-- POLICY -->
<div id="policy-section">
    <div class="policy-container">
        <div class="policy-item">
            <i class="fa-solid fa-bag-shopping"></i>
            <p>Miễn phí <br> Vận chuyển</p>
        </div>
        <div class="divider"></div>
        <div class="policy-item">
            <i class="fa-solid fa-certificate"></i>
            <p>Sản phẩm <br> Chính hãng</p>
        </div>
        <div class="divider"></div>
        <div class="policy-item">
            <i class="fa-solid fa-wallet"></i>
            <p>Thanh toán <br> Tiện lợi</p>
        </div>
        <div class="divider"></div>
        <div class="policy-item">
            <i class="fa-solid fa-phone-volume"></i>
            <p>Hỗ trợ <br> Chuyên nghiệp</p>
        </div>
    </div>
</div>

<!-- DOG / CAT BANNER -->
<div id="banner-content">
    <div class="header-title">
        <h2>Mua sắm theo giống thú cưng</h2>
    </div>
    <div class="content-item">
        <img src="~/images/dog_banner.webp" alt="Cún cưng" class="dog-item">
        <img src="~/images/cat_banner.webp" alt="Mèo cưng" class="cat-item">
    </div>
</div>

<!-- COLLECTIONS -->
<div id="collections-content">
    <div class="collections-header">
        <h2>Bộ Sưu Tập Cho Mèo Con</h2>
        <a href="#" class="see-all">Xem tất cả</a>
    </div>
    <div class="collections-item">
        <div class="item">
            <img src="~/images/collections_1x.webp">
            <p>Pate Mèo Con</p>
        </div>
        <div class="item">
            <img src="~/images/collections2.webp">
            <p>Thức Ăn Cho Mèo Con</p>
        </div>
        <div class="item">
            <img src="~/images/collections3.webp">
            <p>Cát Vệ Sinh Mèo</p>
        </div>
        <div class="item">
            <img src="~/images/collections4.webp">
            <p>Sữa Tắm Cho Mèo Con</p>
        </div>
        <div class="item">
            <img src="~/images/collections5.webp">
            <p>Đồ Chơi Cho Mèo Con</p>
        </div>
        <div class="item">
            <img src="~/images/collections6.webp">
            <p>Nhà Cho Mèo</p>
        </div>
    </div>
</div>

