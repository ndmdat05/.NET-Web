@{
    ViewData["Title"] = "Trang chủ";
}

<div id="slider-container">
    <div id="slider-cont">
        <div class="slider">
            <div class="slider-item">
                <a asp-controller="Collections" asp-action="PateMeoCon">
                    <img src="~/images/banner-home.webp" alt="Banner Chinh">
                </a>
                <img src="~/images/pet_1.webp" alt="Pet 1">
                <img src="~/images/pet_2.webp" alt="Pet 2">
                <img src="~/images/pet_3.webp" alt="Pet 3">
                <img src="~/images/pet_4.webp" alt="Pet 3">
            </div>
            <div class="dots">
                <i class="fa-solid fa-circle"></i>
                <i class="fa-regular fa-circle"></i>
                <i class="fa-regular fa-circle"></i>
                <i class="fa-regular fa-circle"></i>
            </div>
        </div>
    </div>
</div>

<div id="policy-section">
    <div class="policy-container">
        <div class="policy-item">
            <i class="fa-solid fa-bag-shopping"></i>
            <p>Miễn phí <br> Vận chuyển</p>
        </div>
        <div class="divider"></div>
        <div class="policy-item">
            <i class="fa-solid fa-certificate"></i>
            <p>Sản phẩm <br> Chính hãng</p>
        </div>
        <div class="divider"></div>
        <div class="policy-item">
            <i class="fa-solid fa-wallet"></i>
            <p>Thanh toán <br> Tiện lợi</p>
        </div>
        <div class="divider"></div>
        <div class="policy-item">
            <i class="fa-solid fa-phone-volume"></i>
            <p>Hỗ trợ <br> Chuyên nghiệp</p>
        </div>
    </div>
</div>

<div id="banner-content">
    <div class="header-title">
        <h2>Mua sắm theo giống thú cưng</h2>
    </div>
    <div class="content-item">
        <a asp-controller="Collections" asp-action="PateMeoCon">
            <img src="~/images/dog_banner.webp" alt="Cún cưng" class="dog-item">
        </a>
        <a asp-controller="Collections" asp-action="PateMeoCon">
            <img src="~/images/cat_banner.webp" alt="Mèo cưng" class="cat-item">
        </a>
    </div>
</div>

<div id="collections-content">
    <div class="collections-header">
        <h2>Bộ Sưu Tập Cho Mèo Con</h2>
        <a asp-controller="Collections" asp-action="PateMeoCon" class="see-all">Xem tất cả</a>
    </div>
    <div class="collections-item">
        <div class="item">
            <a asp-controller="Collections" asp-action="PateMeoCon">
                <img src="~/images/collections_1x.webp" alt="Pate Mèo Con">
                <p>Pate Mèo Con</p>
            </a>
        </div>
        <div class="item">
            <a asp-controller="Collections" asp-action="PateMeoCon">
                <img src="~/images/collections2.webp" alt="Thức Ăn">
                <p>Thức Ăn Cho Mèo Con</p>
            </a>
        </div>
        <div class="item">
            <a asp-controller="Collections" asp-action="PateMeoCon">
                <img src="~/images/collections3.webp" alt="Cát Vệ Sinh">
                <p>Cát Vệ Sinh Mèo</p>
            </a>
        </div>
        <div class="item">
            <a asp-controller="Collections" asp-action="PateMeoCon">
                <img src="~/images/collections4.webp" alt="Sữa Tắm">
                <p>Sữa Tắm Cho Mèo Con</p>
            </a>
        </div>
        <div class="item">
            <a asp-controller="Collections" asp-action="PateMeoCon">
                <img src="~/images/collections5.webp" alt="Đồ Chơi">
                <p>Đồ Chơi Cho Mèo Con</p>
            </a>
        </div>
        <div class="item">
            <a asp-controller="Collections" asp-action="PateMeoCon">
                <img src="~/images/collections6.webp" alt="Nhà Mèo">
                <p>Nhà Cho Mèo</p>
            </a>
        </div>
    </div>
</div>

<div class="discount-product">
    <div class="dp_container">
        <div class="dp_header">
            <h2>Sản phẩm giảm giá</h2>
            <a asp-controller="Collections" asp-action="PateMeoCon" class="dp_see_all">Xem tất cả</a>
        </div>

        <div class="dp-slider">
            <div class="dp-wrapper">
                <a asp-controller="Product" asp-action="Detail" class="di-link">
                    <div class="dp-item">
                        <img src="~/images/discount_item1.png" alt="Nutri Plan">
                        <h4>Nutri Plan</h4>
                        <p>Pate Cho Mèo Trưởng Thành Nutri Plan</p>
                        <span class="price1">25.000₫</span>
                        <span class="price2">14.000₫</span>
                        <i class="fa-regular fa-heart dp-icon"></i>
                    </div>
                </a>

                <a asp-controller="Product" asp-action="Detail" class="di-link">
                    <div class="dp-item">
                        <img src="~/images/discount_item2.png" alt="Natural Core">
                        <h4>Natural Core</h4>
                        <p>Bánh Thưởng Cho Chó Natural Core</p>
                        <span class="price1">45.000₫</span>
                        <span class="price2">35.000₫</span>
                        <i class="fa-regular fa-heart dp-icon"></i>
                    </div>
                </a>

                <a asp-controller="Product" asp-action="Detail" class="di-link">
                    <div class="dp-item">
                        <img src="~/images/discount_item3.png" alt="Ultimates Indulge">
                        <h4>Ultimates Indulge</h4>
                        <p>Pate Mèo Ultimates Indulge</p>
                        <span class="price1">27.000₫</span>
                        <span class="price2">21.000₫</span>
                        <i class="fa-regular fa-heart dp-icon"></i>
                    </div>
                </a>

                <a asp-controller="Product" asp-action="Detail" class="di-link">
                    <div class="dp-item">
                        <img src="~/images/discount_item4.png" alt="Royal Canin">
                        <h4>Royal Canin</h4>
                        <p>Pate Cho Mèo Mẹ & Mèo Con</p>
                        <span class="price1">95.000₫</span>
                        <span class="price2">58.000₫</span>
                        <i class="fa-regular fa-heart dp-icon"></i>
                    </div>
                </a>

            </div>
        </div>
    </div>
</div>

<div class="recommend-items">
    <div class="deal_container">
        <div class="deal_header">
            <h2>Sản phẩm đề xuất</h2>
            <a asp-controller="Collections" asp-action="PateMeoCon" class="deal_see_all">Xem tất cả</a>
        </div>

        <div class="deal-slider">
            <div class="deal-wrapper">
                <a asp-controller="Product" asp-action="Detail" class="di-link">
                    <div class="deal-item">
                        <img src="~/images/deal1.png" alt="Silver Spoon">
                        <h4>Silver Spoon</h4>
                        <p>Súp Thưởng Cho Mèo Silver Spoon</p>
                        <span class="price">27.000₫</span>
                        <i class="fa-regular fa-heart deal-icon"></i>
                    </div>
                </a>

                <a asp-controller="Product" asp-action="Detail" class="di-link">
                    <div class="deal-item">
                        <img src="~/images/deal2.png" alt="Silver Spoon">
                        <h4>Silver Spoon</h4>
                        <p>Pate Cho Mèo Silver Spoon Dạng Thạch</p>
                        <span class="price">16.000₫</span>
                        <i class="fa-regular fa-heart deal-icon"></i>
                    </div>
                </a>

                <a asp-controller="Product" asp-action="Detail" class="di-link">
                    <div class="deal-item">
                        <img src="~/images/deal3.png" alt="Silver Spoon">
                        <h4>Silver Spoon</h4>
                        <p>Súp Thưởng Cho Mèo Silver Spoon Dạng Thìa</p>
                        <span class="price">27.000₫</span>
                        <i class="fa-regular fa-heart deal-icon"></i>
                    </div>
                </a>

                <a asp-controller="Product" asp-action="Detail" class="di-link">
                    <div class="deal-item">
                        <img src="~/images/fav2.webp" alt="Royal Canin">
                        <h4>Royal Canin</h4>
                        <p>Thức Ăn Hạt Cho Mèo Con Royal Canin Kitten 36</p>
                        <span class="price">132.000₫</span>
                        <i class="fa-regular fa-heart deal-icon"></i>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

