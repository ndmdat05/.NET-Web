            </div>
            <div class="trade_logo">
                <img src="~/images/trademark2.png" alt="Royal Canin">
                <p>Royal Canin</p>
            </div>
            <div class="trade_logo">
                <img src="~/images/trademark3.png" alt="Kit Cat">
                <p>Kit Cat</p>
            </div>
            <div class="trade_logo">
                <img src="~/images/trademark4.png" alt="Nekko">
                <p>Nekko</p>
            </div>
            <div class="trade_logo">
                <img src="~/images/trademark5.png" alt="Monge">
                <p>Monge</p>
            </div>
            <div class="trade_logo">
                <img src="~/images/trademark6.png" alt="Silver Spoon">
                <p>Silver Spoon</p>
            </div>
            <div class="trade_logo">
                <img src="~/images/trademark7.png" alt="Me-O">
                <p>Me-O</p>
            </div>
            <div class="trade_logo">
                <img src="~/images/trademark8.png" alt="Gimcat">
                <p>Gimcat</p>
