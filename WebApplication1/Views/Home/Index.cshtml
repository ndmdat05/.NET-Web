            <h2 class="title-store">Mua Trực Tiếp Tại Cửa Hàng</h2>
        </div>

        <div class="store-grid">

            <div class="store-item">
                <div class="store-img">
                    <img src="~/images/cuahang1.webp" alt="Paddy Pet Shop - Trường Sa">
                </div>
                <h3>Paddy Pet Shop - Trường Sa</h3>
                <p>168 Trường Sa, P. Gia Định, Tp. HCM</p>
                <button>Chỉ đường</button>
            </div>

            <div class="store-item">
                <div class="store-img">
                    <img src="~/images/cuahang2.webp" alt="Paddy Pet Shop - Nơ Trang Long">
                </div>
                <h3>Paddy Pet Shop - Nơ Trang Long</h3>
                <p>412/3 Nơ Trang Long, P. Bình Lợi Trung, Tp. HCM</p>
                <button>Chỉ đường</button>
            </div>

            <div class="store-item">
                <div class="store-img">
                    <img src="~/images/cuahang3.webp" alt="Paddy Pet Shop - Trần Não">
                </div>
                <h3>Paddy Pet Shop - Trần Não</h3>
                <p>91B Trần Não, P. An Khánh, Tp. HCM</p>
                <button>Chỉ đường</button>
            </div>

            <div class="store-item">
                <div class="store-img">
                    <img src="~/images/cuahang4.webp" alt="Paddy Pet Shop - Nguyễn Thị Thập">
                </div>
                <h3>Paddy Pet Shop - Nguyễn Thị Thập</h3>
                <p>406 Nguyễn Thị Thập, P. Tân Hưng, Tp. HCM</p>
