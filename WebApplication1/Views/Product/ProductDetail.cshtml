@model WebShop.Models.ProductDetailViewModel

@{
    ViewData["Title"] = Model.Name;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Product_Style.css">
}

<div id="container">
    <div id="product_detail">
        <div class="product-detail-left">
            <div class="product-thumbnails">
                <i class="fa-solid fa-chevron-up"></i>

                @if (Model.Images != null && Model.Images.Count > 0)
                {
                    foreach (var img in Model.Images)
                    {
                        <img src="@img" alt="thumb" onclick="changeImage(this.src)">
                    }
                }
                else
                {
                    <img src="/images/default.png" alt="thumb">
                }

                <i class="fa-solid fa-chevron-down"></i>
            </div>

            <div class="product-main-image">
                <img id="main-img"
                     src="@(Model.Images != null && Model.Images.Count > 0 ? Model.Images[0] : "/images/default.png")"
                     alt="main product">
            </div>
        </div>

        <div class="product-detail-right">
            <div class="breadcrumb">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a> >
                <a href="#">Danh mục</a> >
                <span>@Model.Name</span>
            </div>

            <h2>@Model.Name</h2>

            <div class="rating">
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= Math.Round(Model.AverageRating))
                    {
                        <i class="fa-solid fa-star"></i>
                    }
                    else
                    {
                        <i class="fa-regular fa-star"></i>
                    }
                }
                <span>(@Model.ReviewCount đánh giá)</span>
            </div>

            <p class="product-brand">Thương hiệu: <span>@Model.Brand</span></p>

            <div class="product-price">
                <span id="display-old-price" style="text-decoration: line-through; color: #999; font-size: 18px; margin-right: 10px; display: @(Model.SalePrice < Model.Price ? "inline" : "none")">
                    @Model.Price.ToString("N0")đ
                </span>

                <span id="display-price" style="color: #d0021b; font-weight: bold; font-size: 24px;">
                    @(Model.SalePrice > 0 ? Model.SalePrice?.ToString("N0") : Model.Price.ToString("N0"))đ
                </span>
            </div>

            <div class="product-size" style="margin-top: 20px;">
                <p style="font-weight: bold; margin-bottom: 10px;">Chọn:</p>
                <div class="size-options" style="display: flex; gap: 10px;">

                    <button type="button"
                            class="size-btn active"
                            data-price="@((Model.SalePrice > 0 ? Model.SalePrice : Model.Price)?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                            data-stock="@Model.StockQuantity"
                            style="padding: 8px 15px; border: 1px solid #d0021b; background: #fff; color: #d0021b; border-radius: 5px; cursor: pointer;">
                        Tiêu chuẩn
                    </button>

                    @if (Model.Variants != null)
                    {
                        @foreach (var variant in Model.Variants)
                        {
                            <button type="button"
                                    class="size-btn"
                                    data-price="@variant.FinalPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-stock="@variant.Stock"
                                    style="padding: 8px 15px; border: 1px solid #ccc; background: #fff; color: #333; border-radius: 5px; cursor: pointer;">

                                @if (!string.IsNullOrEmpty(variant.VariantName))
                                {
                                    @variant.VariantName
                                }
                                else
                                {
                                    @(variant.Weight.ToString("0.#") + " kg")
                                }
                            </button>
                        }
                    }
                </div>
            </div>

            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="product-quantity">
                    <p>Số lượng:</p>
                    <div class="quantity-control">
                        <button type="button" class="minus" onclick="updateQty(-1)">−</button>
                        <input type="text" name="quantity" id="qtyInput" value="1" readonly>
                        <button type="button" class="plus" onclick="updateQty(1)">+</button>
                    </div>
                </div>

                <div class="product-total" style="margin-top: 10px; color: #666;">
                    Tồn kho: <span id="display-stock" style="font-weight: bold; color: #333;">@Model.StockQuantity</span> sản phẩm
                </div>

                <div class="product-buttons">
                    <button type="submit" class="add-cart">
                        <i class="fa-solid fa-cart-shopping"></i>
                        Thêm vào giỏ hàng
                    </button>

                    
                    <button type="button"
                            class="favorite wishlist-btn"
                            data-id="@Model.Id"
                            data-name="@Model.Name"
                            data-image="@(Model.Images != null && Model.Images.Count > 0 ? Model.Images[0] : "/images/default.png")"
                            data-price="@(Model.SalePrice != null && Model.SalePrice > 0 ? Model.SalePrice : Model.Price)">
                        <i class="fa-regular fa-heart"></i>
                    </button>
                </div>
            </form>

            <div class="product-shipping">
                <i class="fa-solid fa-truck-fast"></i>
                <div>
                    <p><strong>Miễn phí vận chuyển</strong></p>
                    <p>Tối đa 30k cho đơn hàng từ 500k<br>Hoả tốc 4h trong nội thành HCM</p>
                </div>
            </div>
        </div>
    </div>

    <div class="product-description">
        <div class="description-title">
            <h3>Mô Tả</h3>
            <div class="underline"></div>
        </div>

        <div class="desc-content">
            @Html.Raw(Model.Description)
        </div>

        <div class="review-section">
            <h2 class="review-title">ĐÁNH GIÁ SẢN PHẨM</h2>

            @if (Model.Reviews != null && Model.Reviews.Count > 0)
            {
                foreach (var review in Model.Reviews)
                {
                    <div class="review-item">
                        <div class="review-avatar">
                            <span>@review.UserName.Substring(0, 1).ToUpper()</span>
                        </div>
                        <div class="review-body">
                            <p class="review-username">@review.UserName</p>
                            <div class="review-stars">
                                @for (int i = 0; i < review.Rating; i++)
                                {
                                    <i class="fa-solid fa-star"></i>
                                }
                            </div>
                            <p class="review-text">@review.Comment</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>Chưa có đánh giá nào cho sản phẩm này.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Product.js"></script>

    <script>
        function changeImage(src) {
            document.getElementById('main-img').src = src;
        }

        function updateQty(change) {
            var qtyInput = document.getElementById('qtyInput');
            var newQty = parseInt(qtyInput.value) + change;
            if (newQty >= 1) qtyInput.value = newQty;
        }

       
        document.querySelectorAll('.wishlist-btn').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();

                const icon = this.querySelector('i');

                const data = {
                    id: this.dataset.id,
                    name: this.dataset.name,
                    image: this.dataset.image,
                    price: this.dataset.price
                };

                fetch('/Wishlist/Toggle', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: new URLSearchParams(data)
                })
                .then(res => res.json())
                .then(result => {
                    if (result.liked) {
                        icon.classList.remove('fa-regular');
                        icon.classList.add('fa-solid');
                        icon.style.color = 'red';
                    } else {
                        icon.classList.remove('fa-solid');
                        icon.classList.add('fa-regular');
                        icon.style.color = '';
                    }
                });
            });
        });
        document.addEventListener("DOMContentLoaded", function() {
            console.log("Đang khởi tạo sự kiện cho các nút Size...");

            var buttons = document.getElementsByClassName('size-btn');
            for (var i = 0; i < buttons.length; i++) {
                buttons[i].addEventListener('click', function() {
                    // Lấy dữ liệu từ data-attribute (An toàn tuyệt đối)
                    var price = this.getAttribute('data-price');
                    var stock = this.getAttribute('data-stock');

                    // Gọi hàm xử lý giao diện
                    handleSizeClick(this, price, stock);
                });
            }
        });

        // --- 2. Hàm xử lý giao diện ---
        function handleSizeClick(btn, price, stock) {
            console.log("Đã bấm nút! Giá:", price, "Kho:", stock); // Kiểm tra log

            // Reset màu các nút về bình thường
            var buttons = document.getElementsByClassName('size-btn');
            for (var i = 0; i < buttons.length; i++) {
                buttons[i].style.borderColor = '#ccc';
                buttons[i].style.color = '#333';
                buttons[i].classList.remove('active');
            }

            // Tô màu nút được chọn
            btn.classList.add('active');
            btn.style.borderColor = '#d0021b';
            btn.style.color = '#d0021b';

            // Cập nhật giá tiền (Dữ liệu đầu vào chuẩn dạng 132000.00 nên parse rất dễ)
            var priceElem = document.getElementById('display-price');
            if(priceElem) {
                var priceNumber = parseFloat(price);
                priceElem.innerText = priceNumber.toLocaleString('vi-VN') + 'đ';
            }

            // Cập nhật tồn kho
            var stockElem = document.getElementById('display-stock');
            if(stockElem) stockElem.innerText = stock;

            // Ẩn/Hiện giá gốc (chỉ hiện khi chọn Tiêu chuẩn)
            var oldPriceElem = document.getElementById('display-old-price');
            if (oldPriceElem) {
                if (btn.innerText.trim().toLowerCase().includes("tiêu chuẩn")) {
                    oldPriceElem.style.display = 'inline';
                } else {
                    oldPriceElem.style.display = 'none';
                }
            }
        }
    </script>
}
