@model WebShop.Models.SearchResultViewModel
@{
    ViewData["Title"] = "Kết quả tìm kiếm: " + Model.SearchTerm;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Search-result.css">
}

<div class="search-container">
    <div class="search-top">
        <h1>TÌM THẤY <span id="result-count">@Model.TotalCount</span> KẾT QUẢ CHO “<span id="query-text">@Model.SearchTerm</span>”</h1>
    </div>

    <div class="search-layout">
        <div class="search-sidebar">
            <div class="side-section">
                <h3>CATEGORIES</h3>
                <div class="line"></div>
                <ul class="side-list">
                    <li><a asp-controller="Collections" asp-action="Index" asp-route-categoryId="CAT_CHO">Chó</a></li>
                    <li><a asp-controller="Collections" asp-action="Index" asp-route-categoryId="CAT_MEO">Mèo</a></li>
                    <li><a href="#">Hàng mới về</a></li>
                </ul>
            </div>
        </div>

        <main class="search-main">
            <div class="search-controls">
                <div class="sort-left">
                    <label class="label-results">Sắp xếp theo:</label>
                    <form id="sortForm" method="get" action="@Url.Action("SearchResult", "Product")" style="display:inline-block;">
                        <input type="hidden" name="q" value="@Model.SearchTerm" />
                        <select name="sort" class="sort-select" onchange="document.getElementById('sortForm').submit()">
                            <option value="">Phù hợp nhất</option>
                            <option value="price-asc" selected="@(Model.CurrentSort == "price-asc")">Giá: thấp → cao</option>
                        </select>
                    </form>
                </div>
            </div>

            <div class="product-grid" id="product-grid">
                @if (Model.Products != null && Model.Products.Count > 0)
                {
                    foreach (var item in Model.Products)
                    {
                        <div class="product-card">
                            <div class="img-wrap">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id">
                                    <img src="@item.ImageUrl" alt="@item.Name" onerror="this.src='/images/default.png'">
                                </a>
                                <i class="fa-regular fa-heart fav-icon" title="Thêm yêu thích"></i>
                            </div>

                            <a class="brand" href="#">@item.Brand</a>

                            <a class="product-name" asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id">
                                <h3 class="p-title">@item.Name</h3>
                            </a>

                            <div class="rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(item.Rating))
                                    {
                                        <i class="fa-solid fa-star"></i>
                                    }
                                    else
                                    {

                                        <i class="fa-regular fa-star"></i>
                                    }
                                }
                                <span class="rating-count">@item.ReviewCount đánh giá</span>
                            </div>

                            @if (item.SalePrice > 0 && item.SalePrice < item.Price)
                            {
                                <div class="price">
                                    <span style="text-decoration: line-through; color: #999; font-size: 14px;">@item.Price.ToString("N0")đ</span>
                                    <span style="color: #d0021b; font-weight: bold; margin-left: 5px;">@item.SalePrice?.ToString("N0")đ</span>
                                </div>
                            }
                            else
                            {
                                <div class="price">@item.Price.ToString("N0")đ</div>
                            }
                        </div>
                    }
                }
                else
                {
                    <p style="grid-column: 1/-1; text-align: center; padding: 50px;">
                        Không tìm thấy sản phẩm nào phù hợp với từ khóa "<strong>@Model.SearchTerm</strong>".
                    </p>
                }
            </div>

            @if (Model.TotalCount > 20)
            {
                <div class="pagination">
                    <button class="page-btn active">1</button>
                </div>
            }
        </main>
    </div>
</div>