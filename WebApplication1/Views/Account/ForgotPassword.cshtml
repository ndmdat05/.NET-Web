@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/style.css">
    <link rel="stylesheet" href="~/css/Forget-password.css">
</head>
<body>
    <div class="container">
        <form id="forgot-form">
            <h2>Quên mật khẩu</h2>
            <label>Email Address</label>
            <input type="email" id="email" placeholder="Nhập vào email của bạn" required>

            <a asp-controller="Account" asp-action="ForgotSuccess" class="btn-reset">Đặt lại mật khẩu</a>

            <a asp-controller="Account" asp-action="Login" class="back-login">Trở lại trang đăng nhập</a>
        </form>
    </div>
</body>
</html>