@model WebShop.Models.LoginViewModel

@{
    Layout = null; // Ngắt bỏ Header/Footer chung
    ViewData["Title"] = "Đăng nhập";
}

<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/DangNhap.css">
</head>
<body>
    <form asp-action="login" method="post" class="login-box">
        <h2>Đăng nhập</h2>

        <label for="username">Tên đăng nhập</label>
        <input asp-for="Email" type="text" id="username" placeholder="Nhập email đăng nhập" required>
        <span asp-validation-for="Email" class="text-danger"></span>

        <label for="password">Mật khẩu</label>
        <input asp-for="Password" type="password" id="password" placeholder="Nhập mật khẩu" required>
        <span asp-validation-for="Password" class="text-danger"></span>

        <div class="text-danger">
            @Html.ValidationSummary()
        </div>
        @* <a asp-controller="Home" asp-action="Index" class="btn-login" onclick="goToIndex()">Đăng nhập</a> *@
        <button type="submit" class="btn-login">Đăng nhập</button>
        <p class="login-link">
            Chưa có tài khoản?
            <a asp-controller="Account" asp-action="Register">Đăng ký</a>
        </p>

        <a asp-controller="Account" asp-action="ForgotPassword">Quên mật khẩu</a>
    </form>

    <script src="~/js/DangNhap.js"></script>
</body>
</html>