@{
    Layout = null; // Không dùng Header/Footer chung
    ViewData["Title"] = "Password Reset Successful";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/Forget-success.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <div class="success-box">
        <div class="success-icon">
            <i class="fa-solid fa-circle-check"></i>
        </div>

        <h2>Reset mật khẩu thành công</h2>
        <p class="success-msg">
            Mật khẩu mới đã được gửi đến email của bạn.
            Vui lòng kiểm tra hộp thư (kể cả Spam).
        </p>

        <a asp-controller="Account" asp-action="Login" class="success-btn">Trở về trang đăng nhập</a>
    </div>

</body>
</html>