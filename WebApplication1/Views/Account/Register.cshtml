@model WebShop.Models.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng ký tài khoản";
}

<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/DangKyTK.css">
</head>
<body>
    <div class="register-box">
        <h2>Đăng ký tài khoản</h2>
        <form asp-action="Register" method="post">
        <label for="fullname">Họ và tên</label>
        <input asp-for="FullName" type="text" id="fullname" placeholder="Nhập họ và tên" required>

        <label for="email">Email</label>
        <input asp-for="Email" type="email" id="email" placeholder="Nhập email" required>

        <label for="password">Mật khẩu</label>
        <input asp-for="Password" type="password" id="password" placeholder="Tạo mật khẩu" required>

        <label for="confirm">Nhập lại mật khẩu</label>
        <input asp-for="ConfirmPassword" type="password" id="confirm" placeholder="Nhập lại mật khẩu" required>

        @* <a asp-controller="Home" asp-action="DangNhap" class="btn-register" onclick="registerSuccess()">Đăng ký</a> *@
            <button type="submit" class="btn-register">Đăng ký</button>
        </form>
        <p class="login-link">
            Đã có tài khoản?
            <a asp-controller="Home" asp-action="DangNhap">Đăng nhập</a>
        </p>
    </div>

    <script src="~/js/DangKyTK.js"></script>
</body>
</html>