@model List<WebShop.Models.OrderItem>
@{
    ViewData["Title"] = "Chi tiết trạng thái đơn hàng";
}

@section Styles {
    <link rel="stylesheet" href="~/css/SDetail_Style.css">
}

<div class="status-detail">
    <div class="sd-container">
        <div class="sd-header">
            <h2>Chi tiết trạng thái đơn hàng</h2>
        </div>
        <div class="sd-content">
            @if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        <div class="sd-info">
            <img src="@item.ProductImage" class="sd-img">

            <div class="sd-item">
                <p class="sd-name">@item.ProductName</p>
                <p class="sd-price">
                    Giá:
                    <span class="sd-price-detail">
                        @item.UnitPrice.ToString("N0")đ
                    </span>
                </p>
                <p>Số lượng: @item.Quantity</p>
            </div>
        </div>
    }
}
else
{
    <p>Không tìm thấy chi tiết đơn hàng.</p>
}

            </div>

            <div class="sd-line">
                <i class="bi bi-dot active"></i>
                <div class="line-between active"></div>

                <i class="bi bi-dot active"></i>
                <div class="line-between active"></div>

                <i class="bi bi-dot active"></i>
                <div class="line-between"></div>

                <i class="bi bi-dot"></i>
            </div>

            <div class="sd-labels">
                <span class="label active">Đã đặt hàng</span>
                <span class="label active">Đang đóng gói</span>
                <span class="label active">Đang vận chuyển</span>
                <span class="label">Đã giao</span>
            </div>

            <div class="sd-return">
                <a asp-controller="Account"
                   asp-action="ProductStatus"
                   class="bt-return">
                    Trở lại trang "Trạng thái đơn hàng"
                </a>
            </div>
        </div>
    </div>
</div>