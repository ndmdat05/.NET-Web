@model List<WebShop.Models.OrderDetailViewModel>

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    decimal grandTotal = Model?.Sum(x => x.TotalPrice) ?? 0;
}

<link rel="stylesheet" href="~/css/PStatus_Style.css" />

<div class="ps-container">

    <div style="margin-bottom: 20px;">
        <a href="/Account/ProductStatus" class="btn-back">
            <i class="fa-solid fa-arrow-left" style="margin-right: 8px;"></i> Quay lại danh sách
        </a>
    </div>

    <div class="order-card">
        <div class="card-header">
            <i class="fa-solid fa-receipt" style="margin-right: 10px;"></i> Chi tiết sản phẩm
        </div>

        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th style="width: 45%">Sản phẩm</th>
                        <th style="text-align: center;">Đơn giá</th>
                        <th style="text-align: center;">Số lượng</th>
                        <th style="text-align: right;">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center;">
                                        <img src="@item.ImageUrl" alt="@item.ProductName"
                                             style="width: 60px; height: 60px; object-fit: cover; border-radius: 4px; border: 1px solid #eee; margin-right: 15px;"
                                             onerror="this.src='/images/default.png'">
                                        <div>
                                            <div style="font-weight: 600; color: #333;">@item.ProductName</div>
                                            <small style="color: #888;">ID: @item.ProductId</small>
                                        </div>
                                    </div>
                                </td>
                                <td style="text-align: center;">@item.UnitPrice.ToString("N0")đ</td>
                                <td style="text-align: center;">
                                    <span style="background: #f1f3f9; padding: 4px 12px; border-radius: 4px; font-weight: 600;">x@item.Quantity</span>
                                </td>
                                <td style="text-align: right; color: #4e73df; font-weight: 700;">
                                    @item.TotalPrice.ToString("N0")đ
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot style="background-color: #f8f9fc;">
                    <tr>
                        <td colspan="3" style="text-align: right; padding: 15px; font-weight: 600; color: #666;">
                            TỔNG CỘNG:
                        </td>
                        <td style="text-align: right; padding: 15px; font-size: 18px; color: #e74a3b; font-weight: 700;">
                            @grandTotal.ToString("N0")đ
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div style="padding: 15px; text-align: right; border-top: 1px solid #e3e6f0;">
            <button onclick="window.print()" style="background: #1cc88a; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer;">
                <i class="fa-solid fa-print"></i> In hóa đơn
            </button>
        </div>
    </div>
</div>