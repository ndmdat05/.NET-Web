@model List<WebShop.Models.HistoryOrderViewModel>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<link rel="stylesheet" href="~/css/PStatus_Style.css" />

<div class="ps-container">
    <div class="order-card">
        <div class="card-header">
            <i class="fa-solid fa-box-open" style="margin-right: 10px;"></i> Lịch sử đơn hàng
        </div>
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var order in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@order.OrderId</td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-danger">@order.TotalAmount.ToString("N0")đ</td>
                                <td>
                                    @{
                                        string badgeClass = "bg-secondary";
                                        if (order.Status.Contains("Giao") || order.Status.Contains("Hoàn")) badgeClass = "bg-success";
                                        else if (order.Status.Contains("Hủy")) badgeClass = "bg-danger";
                                        else if (order.Status.Contains("Xử lý") || order.Status.Contains("Chờ")) badgeClass = "bg-warning";
                                    }
                                    <span class="status-badge @badgeClass">@order.Status</span>
                                </td>
                                <td class="text-right">
                                    <a asp-action="StatusDetails" asp-route-id="@order.OrderId" class="btn-detail">
                                        Xem chi tiết <i class="fa-solid fa-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align:center; padding: 40px;">
                                <p>Bạn chưa có đơn hàng nào.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>