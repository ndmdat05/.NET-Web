@model List<WebShop.Models.OrderViewModel>
@{
    ViewData["Title"] = "Trạng thái đơn hàng";
}

@section Styles {
    <link rel="stylesheet" href="~/css/PStatus_Style.css">
}

<div class="product-status">
    <div class="ps-container">
        <div class="ps-header">
            <h2>Trạng thái đơn hàng đã đặt</h2>
        </div>
        <div class="ps-content">
            <table class="ps-table">
                <thead>
                    <tr>
                        <th>SẢN PHẨM</th>
                        <th>GIÁ</th>
                        <th>TRẠNG THÁI</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model != null && Model.Any())
                {
            foreach (var order in Model)
            {
                     <tr class="ps-item">
            <td class="ps-info">
                <img src="~/images/fav4.webp" alt="" class="ps-img">
                <div>
                    <p class="ps-name">Đơn hàng #@order.Id</p>
                    <p class="ps-brand">@order.CustomerName</p>
                </div>
            </td>

            <td class="ps-price">
                @order.TotalAmount.ToString("N0")đ
            </td>

            <td class="ps-stt-shipping">
                @order.Status
            </td>

            <td class="ps-details">
                <a asp-controller="Account"
                   asp-action="StatusDetails"
                   asp-route-id="@order.Id"
                   class="ps-button">
                    Xem chi tiết
                </a>
            </td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="4" style="text-align:center">
            Bạn chưa có đơn hàng nào
        </td>
    </tr>
}
</tbody>

            </table>
        </div>
    </div>
</div>