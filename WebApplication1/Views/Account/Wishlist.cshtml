@model List<WebShop.Models.WishlistViewModel>
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Sản phẩm yêu thích";
    var currentUserId = HttpContextAccessor.HttpContext.Session.GetString("UserId");
}

<div class="wish-list">
    <div class="wl-container">
        <h2>Danh sách sản phẩm yêu thích</h2>

        @if (Model == null || !Model.Any())
        {
            <p style="text-align:center; margin: 20px;">Chưa có sản phẩm nào ❤️</p>
        }
        else
        {
            <div class="wl-wrapper" style="display:flex; flex-wrap:wrap; gap:20px;">
                @foreach (var item in Model)
                {
                    <div class="wl-item" style="border:1px solid #ddd; padding:10px; width:200px;">
                        <img src="@item.ImageUrl" alt="@item.ProductName" style="width:100%; height:auto;">
                        <h4>@item.ProductName</h4>
                        <span class="price">@item.Price.ToString("N0")₫</span>

                        <button onclick="removeWishlist('@item.ProductId')" class="btn btn-danger btn-sm" style="margin-top:5px;">
                            Bỏ thích
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function removeWishlist(id) {
            $.post("/Wishlist/Toggle", { id: id }, function(data) {
                location.reload();
            });
        }
    </script>
}