@using WebShop.Models
@model List<Wishlist>

@{
    ViewData["Title"] = "Danh sách sản phẩm yêu thích";
}

@section Styles {
    <link rel="stylesheet" href="~/css/wishlist_Style.css">
}

<div class="wish-list">
    <div class="wl-container">
        <div class="wl-header">
            <h2>Danh sách sản phẩm yêu thích</h2>
        </div>

        @if (Model == null || !Model.Any())
        {
            <p style="text-align:center; margin:40px 0;">
                Chưa có sản phẩm nào trong danh sách yêu thích ❤️
            </p>
        }
        else
        {
            <div class="wl-slider">
                <div class="wl-wrapper">
                    @foreach (var item in Model)
                    {
                        <div class="wl-item">
                            <a asp-controller="Product"
                               asp-action="Detail"
                               asp-route-id="@item.Id">
                                <img src="@item.Image"
                                     alt="@item.Name">
                            </a>

                            <h4>@item.Name</h4>

                            <span class="price">
                                @item.Price.ToString("N0")₫
                            </span>

                            <!-- ❤️ BỎ YÊU THÍCH -->
                            <i class="fa-solid fa-heart wl-icon"
                               title="Bỏ thích"
                               onclick="removeWishlist(@item.Id)">
                            </i>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function removeWishlist(id) {
            fetch('/Wishlist/Toggle', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${id}`
            })
            .then(res => res.json())
            .then(data => {
                if (!data.liked) {
                    location.reload();
                }
            });
        }
    </script>
}
