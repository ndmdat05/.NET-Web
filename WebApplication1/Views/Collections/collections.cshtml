                <div class="filter-box">
                    <h3>Loại Sản Phẩm</h3>
                    <div class="filter-list">
                        <label>
                            <input type="checkbox" name="category">
                            <span>Thức Ăn Ướt (48)</span>
                        </label>
                        <label>
                            <input type="checkbox" name="category">
                            <span>Thức Ăn Khô (28)</span>
                        </label>
                        <label>
