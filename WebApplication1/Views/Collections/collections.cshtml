@model WebShop.Models.CollectionViewModel
@{
    ViewData["Title"] = Model.CurrentCategoryName;
}

@section Styles {
    <link rel="stylesheet" href="~/css/collections_Style.css">
}

<div class="collections-shop">
    <div class="cs-header">
        <a asp-controller="Home" asp-action="Index">Paddy Pet Shop</a> >
        <a href="#">Collections</a> >
        <span>@Model.CurrentCategoryName</span>
    </div>

    <div class="cs-container">
        <div class="cs-title-header">
            <h2>@Model.CurrentCategoryName</h2>
        </div>
        <hr>

        <div class="cs-layout">
            <div class="cs-sidebar">
                <div class="filter-box">
                    <h3>Danh Mục</h3>
                    <div class="filter-list">
                        <div style="margin-bottom: 10px;">
                            <a href="@Url.Action("Index", "Collections", new { categoryId = "CAT002" })"
                               style="text-decoration: none; color: @(Model.CurrentCategoryId == "CAT002" ? "#d0021b" : "#333"); font-weight: @(Model.CurrentCategoryId == "CAT_MEO" ? "bold" : "normal")">
                                Thức ăn cho Mèo
                            </a>
                        </div>
                        <div style="margin-bottom: 10px;">
                            <a href="@Url.Action("Index", "Collections", new { categoryId = "CAT001" })"
                               style="text-decoration: none; color: @(Model.CurrentCategoryId == "CAT001" ? "#d0021b" : "#333"); font-weight: @(Model.CurrentCategoryId == "CAT_CHO" ? "bold" : "normal")">
                                Thức ăn cho Chó
                            </a>
                        </div>
                        <div style="margin-bottom: 10px;">
                            <a href="@Url.Action("Index", "Collections")" style="text-decoration: none; color: #333;">
                                Xem tất cả
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cs-main">
                <div class="cs-softbox">
                    <span class="sb-label">SẮP XẾP THEO</span>

                    <form id="sortForm" method="get" action="@Url.Action("Index", "Collections")">
                        <input type="hidden" name="categoryId" value="@Model.CurrentCategoryId" />

                        <input type="hidden" name="keyword" value="@Model.CurrentKeyword" />

                        <select name="sort" class="soft-select" onchange="document.getElementById('sortForm').submit()">
                            <option value="">Mới nhất</option>
                            <option value="alpha-asc" selected="@(Model.CurrentSort == "alpha-asc")">Thứ tự bảng chữ cái (từ A-Z)</option>
                            <option value="alpha-desc" selected="@(Model.CurrentSort == "alpha-desc")">Thứ tự bảng chữ cái (từ Z-A)</option>
                            <option value="price-asc" selected="@(Model.CurrentSort == "price-asc")">Giá tăng dần</option>
                            <option value="price-desc" selected="@(Model.CurrentSort == "price-desc")">Giá giảm dần</option>
                        </select>
                    </form>
                </div>

                <div class="cs-slider">
                    <div class="cs-wrapper" style="display: flex; flex-wrap: wrap; gap: 20px; justify-content: flex-start;">

                        @if (Model.Products != null && Model.Products.Count > 0)
                        {
                            foreach (var item in Model.Products)
                            {
                                <div class="cs-item" style="width: 23%; min-width: 200px; border: 1px solid #eee; padding: 10px; border-radius: 8px; margin-bottom: 20px; background: #fff;">
                                    <a href="/Product/Detail?id=@item.Id" style="text-decoration: none; color: inherit; display: block;">

                                        <div style="height: 200px; display: flex; align-items: center; justify-content: center; overflow: hidden; margin-bottom: 10px;">
                                            <img src="@item.ImageUrl" alt="@item.Name"
                                                 style="max-width: 100%; max-height: 100%; object-fit: contain;"
                                                 onerror="this.src='/images/default.png'">
                                        </div>

                                        <h4 style="font-size: 14px; height: 40px; overflow: hidden; margin-bottom: 5px; line-height: 1.3;">@item.Name</h4>

                                        <div class="cs-rating" style="margin-bottom: 5px;">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= Math.Round(item.Rating))
                                                {
                                                    <i class="fa-solid fa-star" style="color: #ffc107;"></i>
                                                }
                                                else
                                                {

                                                    <i class="fa-regular fa-star" style="color: #ccc;"></i>
                                                }
                                            }
                                            <span style="font-size: 12px; color: #666;">(@item.ReviewCount)</span>
                                        </div>

                                        @if (item.SalePrice > 0 && item.SalePrice < item.Price)
                                        {
                                            <div>
                                                <span class="price1" style="text-decoration: line-through; color: #999; font-size: 13px; margin-right: 5px;">@item.Price.ToString("N0")đ</span>
                                                <span class="price2" style="color: #d0021b; font-weight: bold; font-size: 16px;">@item.SalePrice?.ToString("N0")đ</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                <span class="price" style="color: #d0021b; font-weight: bold; font-size: 16px;">@item.Price.ToString("N0")đ</span>
                                            </div>
                                        }

                                        <div style="text-align: right; margin-top: 5px;">
                                            <i class="fa-regular fa-heart cs-icon" style="cursor: pointer;"></i>
                                        </div>
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <div style="width: 100%; text-align: center; padding: 50px;">
                                <p>Chưa có sản phẩm nào trong danh mục này.</p>
                                <a href="@Url.Action("Index", "Home")" style="color: #d0021b;">Quay về trang chủ</a>
                            </div>
                        }
                    </div>
                </div>

                <div class="cs-see-more">
                    <span class="sm-span">Hiển thị @Model.Products.Count sản phẩm</span>
                </div>
            </div>
        </div>
        <hr>

        <div class="cs-description">
            <h3>Recently Viewed Products</h3>
            <div class="cs-des-container">
                <h2>Pate Cho Mèo Con | Wet Food For Kitten</h2>
                <br>
                <p>
                    Pate cho mèo con là thức ăn ướt dành cho mèo con được làm từ thịt, cá, gan xay nhuyễn và kết hợp
                    với khoáng chất, vitamin cùng các chất cần thiết để bổ sung hàm lượng dinh dưỡng cho mèo.
                    Pate sẽ có dạng ướt, lỏng, có mùi thơm kích thích vị giác của mèo.
                    Cùng <strong>Paddy</strong> giới thiệu về các vai trò của pate dành cho mèo con trong quá trình chăm sóc "Hoàng Thượng" nhé
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Collections.js"></script>
}